{
  "name": "amruni-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --experimental-vm-modules server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:patient": "vite build --outDir dist/patient",
    "build:doctor": "vite build --mode doctor --outDir dist/doctor",
    "build:admin": "vite build --mode admin --outDir dist/admin",
    "build:all": "npm run build:patient && npm run build:doctor && npm run build:admin",
    "dev:doctor": "vite --mode doctor",
    "dev:admin": "vite --mode admin",
    "typecheck": "tsc -p tsconfig.json",
    "dev:https": "HTTPS=1 vite"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.12"
  }
}
