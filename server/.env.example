# Amruni backend configuration.
# On Railway set these under Service → Variables (do not commit real values).

# ---- required in production -------------------------------------------------
ENV=production
# Signs session JWTs and salts OTP hashes. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every existing session.
JWT_SECRET=

# ---- storage ----------------------------------------------------------------
# Railway's filesystem is ephemeral: without a Volume every deploy wipes the
# database. Attach a Volume (mount path /data) and point DB_PATH inside it.
# The trained ML models are cached next to it and survive restarts too.
DB_PATH=/data/amruni.db

# ---- networking -------------------------------------------------------------
# PORT is injected by Railway — do not set it yourself.
# Comma-separated browser origins. Native Android/iOS clients ignore CORS, so
# this only matters for the web build, a WebView or Capacitor. Defaults to "*"
# in production, which is safe here because auth is a Bearer token, not cookies.
# ALLOWED_ORIGINS=https://your-web-app.up.railway.app

# ---- test numbers (mobile-app development) ----------------------------------
# Fixed-OTP numbers, like Firebase Auth test numbers. Comma-separated
# `phone:code` pairs (6-digit codes). These skip SMS and accept their fixed
# code, so your Android app can log in deterministically without a gateway.
# Every other number still gets a random OTP and cannot be impersonated.
# Remove these before a real public launch.
# TEST_OTP_NUMBERS=9000000001:123456,9000000002:123456

# ---- admin ------------------------------------------------------------------
# Password for the /admin portal. No default in production: leave it unset to
# disable password login entirely.
ADMIN_PASSWORD=
# Optional: comma-separated phone numbers allowed to manage doctors/slots
# without the portal password.
# ADMIN_PHONES=9876543210

# ---- integrations (all optional; sensible fallbacks when unset) -------------
# Payments — unset uses the mock provider (instant success, good for demos).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Video — unset generates joinable Jitsi rooms instead of Google Meet.
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/google-service-account.json
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_IMPERSONATE_SUBJECT=doctor@yourdomain.com
# MEET_TIMEZONE=Asia/Kolkata

# ---- datasets (optional overrides) ------------------------------------------
# Resolved automatically from server/datasets/ — only set these if you move them.
# FEDCYCLE_PATH=
# PCOS_XLSX_PATH=
